---
import Layout from '../layouts/Layout.astro';import Media from '../components/Media.astro';import resources from '../content/resources.json';import {localHTML} from '../lib/site';const categories=['Robot','Sensor','Etc.','Server','WorkStation'];
---
<Layout title="Resource"><nav class="year-nav resource-nav" aria-label="Resource categories">{categories.map(c=><a href={`#${c.replace('.','')}`}>{c==='WorkStation'?'Workstation':c}</a>)}</nav>{categories.map(category=><section id={category.replace('.','')} class="resource-section"><h2>{category}</h2><div class:list={[['Server','WorkStation'].includes(category)?'compute-resources':'resource-grid']}>{resources.filter(x=>x.category===category).map(item=><article class="resource-card" data-record-id={item.id}><Media source={item.imageSource} alt={item.title}/>{item.body?<details open><summary>{item.title}</summary><div class="prose" set:html={localHTML(item.body)}></div></details>:<h3>{item.title}</h3>}</article>)}</div></section>)}</Layout>
