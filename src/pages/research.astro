---
import Layout from '../layouts/Layout.astro';import Media from '../components/Media.astro';import Detail from '../components/Detail.astro';import areas from '../content/research-areas.json';import groups from '../content/research-groups.json';import {localHTML} from '../lib/site';
---
<Layout title="Research"><h2>Research Interests</h2><Detail name="research-intro"/>{['3D VISION','Robot vision'].map((category,i)=><section class="research-group"><div class="research-group-description prose" set:html={localHTML(groups[i]?.body||'')}></div><div class="research-grid">{areas.filter(x=>x.category===category).map(area=><article class="research-card"><h3>{area.title}</h3><Media source={area.imageSource} alt={area.title}/><button class="research-open" data-open-dialog={area.id}>Click Here<span class="sr-only">: {area.title}</span></button></article>)}</div></section>)}{areas.map(area=><dialog id={area.id} class="research-dialog" aria-label={area.title}><button class="dialog-close" data-close-dialog aria-label={`Close ${area.title} details`}>×</button><Detail name={`research-${area.id}`}/></dialog>)}</Layout>
