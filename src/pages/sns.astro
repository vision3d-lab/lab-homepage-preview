---
import Layout from '../layouts/Layout.astro';import posts from '../content/instagram.json';
---
<Layout title="SNS"><section class="social-section"><h2>Link</h2><div class="social-icons"><a href="https://www.youtube.com/channel/UCO16QYRuoZBroLyvRnxdYwA" target="_blank" rel="noopener noreferrer"><span class="youtube-mark" aria-hidden="true">▶</span> YouTube</a><a href="https://github.com/vision3d-lab" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.8.1-.8.1-.8 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.7.4-1.3.8-1.6-2.7-.3-5.5-1.4-5.5-6a4.7 4.7 0 0 1 1.3-3.2c-.1-.3-.6-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.6 11.6 0 0 1 6 0C17.4 5.1 18.4 5.4 18.4 5.4c.7 1.7.2 2.9.1 3.2a4.7 4.7 0 0 1 1.3 3.3c0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"/></svg> GitHub</a></div></section><section class="social-section"><h2>Instagram</h2><div class="instagram-grid">{posts.map(post=><article class="instagram-post" data-record-id={post.id}><blockquote class="instagram-media" data-instgrm-permalink={post.url} data-instgrm-version="14"><a href={post.url} target="_blank" rel="noopener noreferrer">{post.title}</a></blockquote><a class="instagram-fallback" href={post.url} target="_blank" rel="noopener noreferrer">Instagram에서 보기</a></article>)}</div><p class="instagram-follow"><a href="https://www.instagram.com/3dvision_and_robotics_lab/" target="_blank" rel="noopener noreferrer">Follow on Instagram</a></p></section><script is:inline async src="https://www.instagram.com/embed.js"></script></Layout>
