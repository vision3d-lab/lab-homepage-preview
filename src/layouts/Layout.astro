---
import '../styles/site.css';
import {href,preview,menu,asset} from '../lib/site';
interface Props{title:string;home?:boolean}
const {title,home=false}=Astro.props;const current=Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/,''),'')||'/';
const logo=asset('https://unist.info/wp-content/uploads/2025/01/연구실new로고.png');
const canonical=new URL(href(title==='Page not found'?'/404.html':current),'https://vision3d-lab.github.io').href;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title==='Home'?'3D Vision & Robotics Lab @ UNIST':`${title} | 3D Vision & Robotics Lab @ UNIST`}</title><meta name="description" content="3D Vision & Robotics Lab at UNIST. Research, publications, people, and opportunities in 3D computer vision and robotics."/>{preview&&<meta name="robots" content="noindex,nofollow"/>}<link rel="canonical" href={canonical}/><link rel="icon" type="image/webp" href={logo?href(logo.path):undefined}/><link rel="stylesheet" href={href('/lab-fonts/fonts.css')}/><link rel="preload" href={href('/lab-fonts/open-sans-400.woff2')} as="font" type="font/woff2" crossorigin/><meta property="og:title" content={`${title} | 3D Vision & Robotics Lab @ UNIST`}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/></head>
<body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><div class="header-inner"><a class="brand" href={href('/')} aria-label="3D Vision & Robotics Lab home">{logo&&<img src={href(logo.path)} alt="3D Vision & Robotics Lab" width="194" height="64"/>}</a><button class="mobile-toggle" aria-controls="primary-navigation" aria-expanded="false" aria-label="Open navigation">☰</button><nav id="primary-navigation" aria-label="Main navigation"><ul>{menu.map((item,i)=><li class:list={['nav-item',{'has-submenu':!!item.children}]}><div class="nav-parent"><a href={href(item.url)} aria-current={current===item.url?'page':undefined}>{item.label}</a>{item.children&&<button class="submenu-toggle" aria-controls={`submenu-${i}`} aria-expanded="false" aria-label={`Show ${item.label} menu`}>⌄</button>}</div>{item.children&&<ul class="submenu" id={`submenu-${i}`}>{item.children.map(child=><li><a href={href(child.url)} aria-current={current===child.url?'page':undefined}>{child.label}</a></li>)}</ul>}</li>)}</ul></nav></div></header>
{preview&&<aside class="preview-notice" aria-label="Preview status">미리보기 · 검토 후 정식 홈페이지에 적용합니다</aside>}
<main id="main" class:list={['site-main',{home}]} tabindex="-1">{!home&&<h1 class="page-title">{title}</h1>}<slot/></main>
<script src="../scripts/ui.ts"></script>
</body></html>
